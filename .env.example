# 复制本文件为 .env 并填入真实值（.env 不要提交到 git）

# 服务监听端口
PORT=3000

# 会话令牌签名密钥：必填。
# 缺失、留空或仍是 dev-only-change-me / change-me / secret 之一时，
# 服务会直接 process.exit(1)（决策 D-7），不会静默降级为弱密钥。
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-random-32-bytes-hex

# 飞书自建应用凭证（开放平台 → 凭证与基础信息）
# 留空即不启用飞书免登，前端 /api/appid 会拿到空串并回落到开发登录入口。
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 开发登录开关（决策 D-8）：POST /api/auth/devlogin 是否可用。
# 不填时缺省 = FEISHU_APP_ID 为空则开放、已配飞书则关闭（向后兼容）。
# 可显式覆盖：true / false。⚠ 对外演示或正式环境务必设为 false。
ALLOW_DEV_LOGIN=true

# SQLite 数据库文件位置（相对或绝对路径均可）
# 云端部署时必须指向持久化磁盘，例如 Render 挂载盘 /data/pm.db，
# 否则重启后数据全部丢失。
DB_PATH=./pm.db

# 初始管理员：填写飞书用户的 open_id（逗号分隔），这些用户首次登录即为管理员
# 留空时，系统中第一个登录的用户会自动成为管理员（引导员机制）
ADMIN_OPEN_IDS=

# 服务对外基址（部署后填 https://你的域名，可选）
BASE_URL=
