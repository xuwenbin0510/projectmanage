# ── pm-app 生产环境变量（复制为 .env 后填值）──
# 生成随机密钥：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# 【必填】会话令牌签名密钥，缺省或仍是默认值服务会直接拒绝启动（config.js D-7 硬校验）
SESSION_SECRET=

# 【必填】生产务必关闭开发免登；不配飞书时该项默认会开启，必须显式 false
ALLOW_DEV_LOGIN=false

# 容器内端口（勿改，compose 已固定 3000）
PORT=3000

# 飞书自建应用凭证（可选；不配则走邮箱+密码登录）
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 逗号分隔的飞书 open_id，首次以这些账号登录即被授予管理员（可选）
ADMIN_OPEN_IDS=

# 数据库与附件路径由 docker-compose 固定为 /app/data，无需在此设置
# DB_PATH=/app/data/pm.db
# ATTACHMENT_ROOT=/app/data/attachments
