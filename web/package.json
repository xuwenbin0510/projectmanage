  "version": "1.0.0",
  "type": "module",
  "description": "太空字节项目管理系统 · 前端（Vite + React + TS + MUI + Tailwind）",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc --noEmit && vite build",
