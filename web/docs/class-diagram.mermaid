%% 第三轮优化（round3-optimize）类图：数据模型 + 服务工具关系
%% 详见 docs/delta-design-round3-optimize.md §3.5

classDiagram
    class MilestoneWithGate {
        +string id
        +string code
        +string name
        +boolean required
        +string baselineDate
        +string currentDate
        +string lastChangeId
        +QualityGate gate
        +MilestoneTaskStats taskStats
    }
    class WbsNode {
        +string id
        +string wbsCode
        +string name
        +string dueDate
        +string milestoneId
        +number progress
    }
    class Report {
        +string id
        +string week
        +string status
        +string authorName
        +string submittedAt
        +string doneNote
        +string[] planItems
        +string resourceNote
        +ReportTaskRow[] tasks
        +ReportRisk[] risks
        +string createdAt
    }
    class ReportTaskRow {
        +string nodeId
        +string nodeName
        +number progressBefore
        +number progressAfter
        +boolean selected
    }
    class ReportRisk {
        +string description
        +string owner
        +string dueDate
    }
    class ProjectMember {
        +string userOpenId
        +string userName
    }
    class ReportAgg {
        <<util>>
        +reportCountByNode(reports) Map~string,number~
        +nodeReportsOf(reports, nodeId) Report[]
    }
    class MemberUtil {
        <<util>>
        +memberNameOf(members, openId) string
    }
    class MilestonesPage
    class WbsPage
    class ReportsPage

    Report "1" --> "*" ReportTaskRow
    Report "1" --> "*" ReportRisk
    ReportTaskRow --> WbsNode : nodeId
    WbsNode --> MilestoneWithGate : milestoneId
    WbsPage --> ReportAgg : 徽标/详情聚合
    WbsPage --> MemberUtil : 责任人姓名
    ReportsPage --> MemberUtil : 责任人姓名
    MilestonesPage --> MilestoneWithGate : 列表/改期/编辑
