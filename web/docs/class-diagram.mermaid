%% ═══════════════════════════════════════════════════════════
%% pm-app · 第五轮增量（round5-wbs）类图
%% 对应 docs/delta-design-round5-wbs.md §3
%% 图例：★ = R5 新增/改动；其余为 R4 既有，本轮只读复用
%% ═══════════════════════════════════════════════════════════

classDiagram
  direction LR

  %% ── 领域模型（不改） ─────────────────────────────
  class WbsNode {
    +string id
    +string parentId
    +string wbsCode
    +WbsNodeType nodeType
    +string name
    +int estimateDays
    +TaskStatus status
    +int progress
    +string milestoneId
  }
  class WbsTreeNode {
    +WbsTreeNode[] children
    +string[] warnings
  }
  WbsTreeNode --|> WbsNode : extends

  class ReportTaskRef {
    +string nodeId
    +int progressAfter
    +boolean selected
  }
  class ReportPayload {
    +string projectId
    +string week
    +string doneNote
    +string[] planItems
    +string resourceNote
    +ReportTaskRef[] tasks
    +RiskInput[] risks
  }
  ReportPayload o-- ReportTaskRef : tasks

  %% ── 叶子口径唯一入口（只读复用 · SK-4） ──────────
  class WbsUtils {
    <<纯函数 · src/utils/wbs.ts · 本轮禁改>>
    +parentIdSet(nodes) Set~string~
    +isLeafNode(nodes, nodeId) boolean
    +flattenTree(tree) WbsTreeNode[]
    +rollupProgress(node) int
    +rollupProgressFlat(nodes, nodeId) int
  }

  %% ── 引擎（本轮禁改，仅标注被调用口径） ───────────
  class MockApiClient {
    <<Mock 引擎 · src/api/mock/index.ts · 本轮禁改>>
    +upsertReport(payload, status) Report
    +createWbsNode(projectId, payload) WbsNode
    -syncWbsProgressStatus(db, projectId) void
  }
  MockApiClient ..> WbsUtils : rollupProgressFlat(父进度唯一口径)

  %% ── 共享弹窗（T1 改动） ──────────────────────────
  class ReportFormModalProps {
    <<Props 签名 R5 不变 · 仅 JSDoc 更新>>
    +boolean open
    +string projectId
    +Report editingReport
    +string lockNodeId
    +boolean keepOpenOnSubmit
    +onSubmitted(report) void
    +onClose() void
  }
  class ReportFormModal {
    <<React 组件 · src/components/report/ReportFormModal.tsx>>
    -Record taskMap
    -string[] planItems
    +Set~string~ parentIds ★派生
    +string effectiveLockNodeId ★派生
    +boolean lockDowngraded ★派生
    +renderTaskTree(list, depth) JSX ★父行禁用
    +assemble(values) ReportPayload ★父节点剔除
    +doSave(values, submit) Promise ★锁定用派生值
  }
  ReportFormModal ..> ReportFormModalProps : props
  ReportFormModal ..> WbsUtils : parentIdSet / flattenTree ★
  ReportFormModal ..> ReportPayload : assemble 产出
  ReportFormModal ..> MockApiClient : 经 flowStore 调用

  %% ── WBS 页（T2 / T3 改动） ───────────────────────
  class NodeForm {
    <<WbsPage 本地表单 state · 字段不变>>
    +string parentId
    +WbsNodeType nodeType
    +string name
    +string owner
    +int estimateDays
    +string status
    +string milestoneId
    +string dueDate
  }
  class WbsPage {
    <<React 组件 · src/pages/projects/WbsPage.tsx>>
    -boolean dialogOpen
    -boolean lockMilestone
    +boolean lockParent ★新增 state
    -boolean reportModalOpen
    -string reportLockNodeId
    +openCreate(parentId) void ★setLockParent
    +openEdit(node) void ★setLockParent(false)
    +changeParent(parentId) void 不改
    +renderNode(node) JSX ★写日志叶子判定
  }
  WbsPage o-- NodeForm : form state
  WbsPage --> ReportFormModal : keepOpenOnSubmit=false ★
  WbsPage ..> WbsUtils : rollupProgress / isLeaf

  %% ── 日志页（不改，回归验证） ─────────────────────
  class ReportsPage {
    <<React 组件 · 本轮不改动>>
    +openCreate() void
    +openCreateWithPrefill(nodeId) void
    +openEditReport(r) void
  }
  ReportsPage --> ReportFormModal : keepOpenOnSubmit=false 现状
