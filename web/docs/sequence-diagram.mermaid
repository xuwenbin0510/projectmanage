%% ═══════════════════════════════════════════════════════════
%% pm-app · 第四轮增量（round4-optimize）时序图（4 条关键流程）
%% 对应 docs/delta-design-round4-optimize.md §4
%% ═══════════════════════════════════════════════════════════

%% ── ① 向导清理后建项（R4-P0-1 + P4 时间驱动背景） ──
sequenceDiagram
  autonumber
  actor U as PM
  participant W as ProjectCreatePage
  participant E as MockApiClient
  participant MS as MilestonesPage
  U->>W: 填写向导（里程碑步骤：无「有质量门」Chip，副标题已清理）
  W->>E: createProject(payload)
  E->>E: 实例化里程碑 + WBS 骨架(per-milestone)
  E->>E: renumberMilestones + refreshMilestoneStatuses
  E-->>W: Project（status=草稿）
  W-->>U: 建项成功
  U->>MS: 打开里程碑页
  MS->>E: listMilestones
  E->>E: refreshMilestoneStatuses（首碑 startFrom=planStart=今天 → 进行中）
  E-->>MS: MilestoneWithGate[]
  MS-->>U: 状态列「进行中」+ 灰字「时间驱动」+ tooltip（起算日已到）

%% ── ② WBS 写日志页内 Modal（R4-P0-4：锁定 → 提交 → 保持打开重置） ──
sequenceDiagram
  autonumber
  actor U2 as 填写人
  participant W2 as WbsPage
  participant M as ReportFormModal
  participant F as flowStore
  participant E2 as MockApiClient
  U2->>W2: 点任务行「写日志」（不再 navigate）
  W2->>W2: setReportLockNodeId(node.id); setReportModalOpen(true)
  W2->>M: <ReportFormModal open lockNodeId keepOpenOnSubmit />
  M->>M: 初始化 taskMap：全不选 + lockNodeId checked
  M-->>U2: 锁定节点 checkbox checked+disabled+锁图标（进度输入可编辑）
  U2->>M: 填写并提交（可追加勾选其他任务）
  M->>F: submitReport(payload)
  F->>E2: upsertReport(payload, '已提交')
  E2->>E2: 回写节点 progress + syncWbsProgressStatus（父节点回写/状态收敛）
  E2->>E2: refreshMilestoneStatuses（★ D3 缺口修复：taskStats 实时联动）
  E2-->>F: Report
  F-->>M: store.reports 已刷新
  M->>M: keepOpenOnSubmit=true → 保持打开并重置（周次=本周、锁定任务不变）
  M-->>U2: 连续添加第二条日志
  U2->>M: 点「关闭」→ onClose
  M-->>W2: WbsPage 关闭 Modal，回到 WBS 树

%% ── ③ 创建/更新子任务 → 父进度汇总 → 状态自动流转 → 里程碑 taskStats（D1/D2/D3） ──
sequenceDiagram
  autonumber
  actor U3 as PM
  participant W3 as WbsPage
  participant S as wbsStore
  participant E3 as MockApiClient
  participant F3 as flowStore
  participant MS3 as MilestonesPage
  U3->>W3: 新建子任务（progress=80）
  W3->>S: createNode(payload)
  S->>E3: createWbsNode(projectId, payload)
  E3->>E3: 校验/编码/落库新节点
  E3->>E3: syncWbsProgressStatus（★ 父节点 progress=子树叶子加权；叶子 0<p<100 且原待办 → 进行中）
  E3->>E3: refreshMilestoneStatuses（taskStats.progress 随叶子实时变化）
  E3-->>S: WbsNode
  S->>S: listWbs 重建 nodes/tree + syncMilestones
  S-->>W3: 树刷新
  W3-->>U3: 父节点行进度条保留且=汇总（悬停 tooltip「{名} {p}%（{状态}）」）
  U3->>W3: 日志提交把该叶子 progress 改到 100
  W3->>F3: submitReport → E3.upsertReport
  E3->>E3: syncWbsProgressStatus（叶子→完成【强规则】；父链全 100 → 完成）
  E3->>E3: refreshMilestoneStatuses
  E3-->>MS3: 里程碑页 taskStats.done/progress 更新，出现「关联任务已全部完成」提示（不自动达成）

%% ── ④ 里程碑页一键标记达成（R4-P1-1 / D3） ──
sequenceDiagram
  autonumber
  actor U4 as PM
  participant MS4 as MilestonesPage
  participant E4 as MockApiClient
  participant S4 as projectStore
  U4->>MS4: 里程碑「关联任务全部完成」提示区点「标记达成」
  MS4->>E4: updateMilestone(id, { achieved: true })
  E4->>E4: ms.doneAt=today(); ms.doneBy=currentUser.openId（★ 审计留痕，引擎不代写）
  E4->>E4: clearOverride + refreshMilestoneStatuses（status → 已达成）
  E4-->>MS4: MilestoneWithGate
  MS4->>S4: refreshMilestones(id)
  MS4-->>U4: 状态列「已达成」（success 绿），来源标识消失
