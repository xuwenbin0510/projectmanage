{
  "id": "LT-A-1",
  "projectType": "A",
  "version": 1,
  "name": "A类（交付类）标准生命周期 v1",
  "isActive": true,
  "definition": {
    "meta": {
      "prd": "P0-02 / P0-03 / P0-05",
      "description": "面向合同交付、含硬件或客户验收的项目。六阶段六门七里程碑，全程强门控。",
      "status": "架构师草拟版（O9/O10），待 PMO 确认后替换"
    },
    "roles": {
      "required": ["pm", "tl"],
      "recommended": ["qa", "cm"],
      "optional": ["po", "pmo"]
    },
    "granularity": {
      "maxLeafDays": 5,
      "warnMessage": "A类项目叶子任务建议不超过 5 人日，请继续拆分（非阻塞告警）"
    },
    "boardDefaults": {
      "columns": [
        { "key": "待办", "label": "待办" },
        { "key": "进行中", "label": "进行中" },
        { "key": "待评审", "label": "待评审" },
        { "key": "完成", "label": "完成" }
      ],
      "wipLimits": { "进行中": 5 }
    },
    "changePolicy": {
      "ccbTriggers": ["milestone_date", "requirement_baseline"],
      "ccbEffortThresholdDays": 3,
      "ccbChain": ["pm", "tl", "po", "customer_rep"],
      "pmOnlyChain": ["pm"]
    },
    "stages": [
      {
        "seq": 1,
        "code": "S1",
        "name": "立项",
        "description": "完成分类判定、目标范围界定、角色任命与里程碑基线建立。",
        "docs": ["项目立项申请书", "项目章程", "初版WBS"],
        "gate": {
          "code": "QG1",
          "name": "立项门",
          "ownerRole": "pmo",
          "items": [
            { "seq": 1, "content": "项目分类判定完成；若覆盖系统建议，覆盖理由已填写且充分", "ownerRole": "pmo" },
            { "seq": 2, "content": "项目目标与范围明确，验收标准可度量（无「尽量」「大约」类表述）", "ownerRole": "pm" },
            { "seq": 3, "content": "客户与合同信息完整：合同额、交付物清单、验收方式、付款节点", "ownerRole": "pm" },
            { "seq": 4, "content": "项目 PM、TL 已任命且各唯一；关键岗位人员到位", "ownerRole": "pmo" },
            { "seq": 5, "content": "一级 WBS 已建立；M1~M7 里程碑基线日期已录入", "ownerRole": "pm" },
            { "seq": 6, "content": "主要风险已识别（≥3 条），每条有应对策略、责任人与时限", "ownerRole": "pm" },
            { "seq": 7, "content": "立项评审已通过（PMO → 管理层），审批留痕完整", "ownerRole": "pmo" }
          ]
        }
      },
      {
        "seq": 2,
        "code": "S2",
        "name": "需求",
        "description": "需求采集、规格化、评审冻结并入配置库形成基线。",
        "docs": ["需求规格说明书", "需求追溯矩阵", "ICD接口控制文件（初稿）"],
        "gate": {
          "code": "QG2",
          "name": "需求基线门",
          "ownerRole": "pmo",
          "items": [
            { "seq": 1, "content": "需求规格说明书已通过正式评审并冻结版本号", "ownerRole": "pm" },
            { "seq": 2, "content": "每条需求有唯一编号，可向上追溯至客户要求/合同条款", "ownerRole": "cm" },
            { "seq": 3, "content": "需求与验收标准一一对应，无「待定 / TBD」遗留项", "ownerRole": "qa" },
            { "seq": 4, "content": "硬件与外部接口需求已与客户书面确认（ICD 初稿签署）", "ownerRole": "tl" },
            { "seq": 5, "content": "需求变更流程已向客户宣贯，CCB 成员名单已确定", "ownerRole": "pm" },
            { "seq": 6, "content": "需求基线已入配置库并锁定，后续修改仅走变更单", "ownerRole": "cm" }
          ]
        }
      },
      {
        "seq": 3,
        "code": "S3",
        "name": "设计",
        "description": "概要设计与详细设计，完成技术评审与二级 WBS 分解。",
        "docs": ["概要设计说明书", "详细设计说明书", "测试策略", "BOM清单"],
        "gate": {
          "code": "QG3",
          "name": "设计评审门",
          "ownerRole": "tl",
          "items": [
            { "seq": 1, "content": "概要设计文档完成并通过技术评审（TL 决议）", "ownerRole": "tl" },
            { "seq": 2, "content": "关键技术方案有备选方案与选型依据，风险点已标注", "ownerRole": "tl" },
            { "seq": 3, "content": "硬件 BOM 与长周期物料已识别，采购已启动并有到货承诺日期", "ownerRole": "pm" },
            { "seq": 4, "content": "设计与需求的双向追溯矩阵完整，无孤儿需求 / 孤儿设计", "ownerRole": "qa" },
            { "seq": 5, "content": "WBS 已细化到二级及以下，叶子任务均 ≤5 人日且有负责人与估算", "ownerRole": "tl" },
            { "seq": 6, "content": "测试策略与测试用例框架已评审通过", "ownerRole": "qa" }
          ]
        }
      },
      {
        "seq": 4,
        "code": "S4",
        "name": "开发与首件调试",
        "description": "编码/装配实现、代码评审、单元测试与首件调试。",
        "docs": ["代码评审记录", "单元测试报告", "首件调试记录"],
        "gate": {
          "code": "QG4",
          "name": "编码与测试门",
          "ownerRole": "qa",
          "items": [
            { "seq": 1, "content": "单元测试覆盖率 ≥60%，关键模块 ≥80%，报告已归档", "ownerRole": "qa" },
            { "seq": 2, "content": "静态检查与代码规范检查无阻塞级问题", "ownerRole": "tl" },
            { "seq": 3, "content": "代码评审全部完成；遗留问题已闭环或有明确关闭计划", "ownerRole": "tl" },
            { "seq": 4, "content": "首件调试完成，功能自测通过，调试记录已签字", "ownerRole": "tl" },
            { "seq": 5, "content": "缺陷库中 P0/P1 级缺陷已清零", "ownerRole": "qa" },
            { "seq": 6, "content": "配置项已全部入库并打版本标签", "ownerRole": "cm" }
          ]
        }
      },
      {
        "seq": 5,
        "code": "S5",
        "name": "集成测试与出厂",
        "description": "系统集成、系统测试、出厂检验与交付物准备。",
        "docs": ["系统测试报告", "出厂检验记录", "用户手册", "验收方案"],
        "gate": {
          "code": "QG5",
          "name": "出厂/验收准备门",
          "ownerRole": "qa",
          "items": [
            { "seq": 1, "content": "系统集成测试用例执行率 100%，通过率 ≥95%", "ownerRole": "qa" },
            { "seq": 2, "content": "遗留缺陷全部有定级、责任人与关闭计划，且无 P0/P1", "ownerRole": "qa" },
            { "seq": 3, "content": "性能 / 环境 / 可靠性测试报告已出具并达标", "ownerRole": "qa" },
            { "seq": 4, "content": "出厂检验记录与测试报告已归档入配置库", "ownerRole": "cm" },
            { "seq": 5, "content": "用户手册、安装手册、维护手册齐备并通过内审", "ownerRole": "pm" },
            { "seq": 6, "content": "客户验收方案与验收标准已双方书面确认", "ownerRole": "pm" }
          ]
        }
      },
      {
        "seq": 6,
        "code": "S6",
        "name": "交付验收与结项",
        "description": "现场交付、客户验收、资料归档、复盘与结项。",
        "docs": ["交付清单", "客户验收报告", "项目复盘报告", "结项申请"],
        "gate": {
          "code": "QG6",
          "name": "结项门",
          "ownerRole": "pmo",
          "items": [
            { "seq": 1, "content": "客户验收报告已签署（含盖章 / 邮件确认凭证）", "ownerRole": "pm" },
            { "seq": 2, "content": "全部里程碑已达成；未按基线达成的均有已批准变更单说明", "ownerRole": "pm" },
            { "seq": 3, "content": "所有变更单已闭环，无「审批中」状态", "ownerRole": "pm" },
            { "seq": 4, "content": "项目文档与配置基线已完整归档", "ownerRole": "cm" },
            { "seq": 5, "content": "财务结算与回款状态已确认", "ownerRole": "pm" },
            { "seq": 6, "content": "项目复盘已完成，经验教训已沉淀入知识库", "ownerRole": "pmo" },
            { "seq": 7, "content": "剩余风险已关闭或书面移交至运维 / 售后", "ownerRole": "pm" }
          ]
        }
      }
    ],
    "milestones": [
      { "code": "M1", "name": "项目启动",       "anchorStage": "S1", "anchor": "end", "required": true,  "hint": "立项评审通过之日" },
      { "code": "M2", "name": "需求基线冻结",   "anchorStage": "S2", "anchor": "end", "required": true,  "hint": "QG2 通过之日" },
      { "code": "M3", "name": "设计评审通过",   "anchorStage": "S3", "anchor": "end", "required": true,  "hint": "QG3 通过之日" },
      { "code": "M4", "name": "首件调试完成",   "anchorStage": "S4", "anchor": "end", "required": true,  "hint": "首件功能自测通过之日" },
      { "code": "M5", "name": "集成测试通过",   "anchorStage": "S5", "anchor": "end", "required": true,  "hint": "QG5 通过之日" },
      { "code": "M6", "name": "客户验收通过",   "anchorStage": "S6", "anchor": "mid", "required": true,  "hint": "客户验收报告签署之日" },
      { "code": "M7", "name": "项目结项",       "anchorStage": "S6", "anchor": "end", "required": true,  "hint": "QG6 通过、项目转归档之日" }
    ],
    "reviews": [
      { "key": "project_kickoff", "reviewType": "project",   "mode": "serial",        "refType": "project",   "chain": ["pmo", "management"],            "title": "项目立项评审" },
      { "key": "req_baseline",    "reviewType": "formal",    "mode": "parallel_veto", "refType": "gate",      "chain": ["pmo", "tl", "customer_rep"],    "title": "需求基线评审（一票否决）" },
      { "key": "design_review",   "reviewType": "technical", "mode": "single",        "refType": "gate",      "chain": ["tl"],                           "title": "设计技术评审" },
      { "key": "code_review",     "reviewType": "code",      "mode": "single",        "refType": "pr",        "chain": ["tl"],                           "title": "代码评审" },
      { "key": "ccb",             "reviewType": "ccb",       "mode": "serial",        "refType": "change",    "chain": ["pm", "tl", "po", "customer_rep"], "title": "变更控制委员会审批" },
      { "key": "project_close",   "reviewType": "formal",    "mode": "parallel_veto", "refType": "gate",      "chain": ["pmo", "qa", "management"],      "title": "结项评审（一票否决）" }
    ]
  }
}
